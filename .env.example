# K-Beauty Analysis — .env example
#
# 사용 시나리오별 어떤 key 채워야 하는지 한 곳에서:
#
#   시나리오                             | 필요한 key
#   -------------------------------------|----------------------------------
#   1. 메인 챗봇 (cosmetic_rag_chat)     | OPENAI_API_KEY → GRAPHRAG_API_KEY
#   2. LightRAG 실험 (lightrag_variant)  | GROQ_API_KEY (+ GEMINI_API_KEY)
#   3. RAG 평가 (tests/rag_eval/)        | GROQ_API_KEY + GEMINI_API_KEY
#   4. Amazon 크롤러                     | CRAWLER_* (8 변수)
#   5. TikTok 크롤러                     | TIKTOK_EMAIL + TIKTOK_PASSWORD
#   6. Slack 알림 (옵션)                 | SLACK_WEBHOOK_URL
#
# 안 쓰는 섹션은 비워둠. 위 시나리오 모두 안 쓸 거면 .env 자체 불필요.
#
# 복사 후 채우기:
#   cp .env.example .env
#   # 본인 시나리오의 key 만 채움


# ─────────────────────────────────────────────────────────────
# 시나리오 1: 메인 챗봇 (GraphRAG + OpenAI) — src/rag_chatbot/cosmetic_rag_chat/
# ─────────────────────────────────────────────────────────────
# 인덱싱 (1회 ~$5) + 챗봇 query (query 당 ~$0.001).
# settings.yaml 안의 ${GRAPHRAG_API_KEY} 가 OpenAI key 로 substitution 됨.
GRAPHRAG_API_KEY=                # sk-...  (https://platform.openai.com/api-keys)


# ─────────────────────────────────────────────────────────────
# 시나리오 2 + 3: LightRAG 실험 + RAG 평가 (무료) — Groq + Gemini
# ─────────────────────────────────────────────────────────────
# src/rag_chatbot/lightrag_variant/ + tests/rag_eval/evaluate.py + src/util/llm_provider.py
# 한쪽 rate-limit 시 다른 쪽 자동 fallback.
#
# LLM_PROVIDER: auto (Groq → Gemini fallback, 권장) / groq / gemini
LLM_PROVIDER=auto
GROQ_API_KEY=                    # gsk_...  (https://console.groq.com 무료 가입, ~1k RPM)
GEMINI_API_KEY=                  # AIza...  (https://aistudio.google.com 무료 발급, ~15 RPM 1.5M TPM/일)

# 모델명 (옵션 — default 권장)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-flash-lite-latest


# ─────────────────────────────────────────────────────────────
# 시나리오 4: Amazon 리뷰 크롤러 — src/amazon_review_crawler/
# ─────────────────────────────────────────────────────────────
# 크롤러 안 실행하면 모두 비워둠.
CRAWLER_ID=                      # Amazon 계정 이메일/ID
CRAWLER_PW=                      # Amazon 계정 비밀번호
CRAWLER_DB_HOST=localhost
CRAWLER_DB_PORT=3306
CRAWLER_DB_NAME=
CRAWLER_DB_USER=
CRAWLER_DB_PASSWORD=
# Optional: read-only replica DB
CRAWLER_DB_REPLICA_URL=


# ─────────────────────────────────────────────────────────────
# 시나리오 5: TikTok 크롤러 — src/tiktok_crawler/
# ─────────────────────────────────────────────────────────────
TIKTOK_EMAIL=
TIKTOK_PASSWORD=


# ─────────────────────────────────────────────────────────────
# 시나리오 6: Slack 알림 (옵션) — src/util/slack.py
# ─────────────────────────────────────────────────────────────
# 크롤러 / 배치 작업 완료/실패 시 webhook 으로 메시지 전송.
SLACK_WEBHOOK_URL=


# ─────────────────────────────────────────────────────────────
# Legacy (settings.yaml 의 fallback 용 — 거의 안 씀)
# ─────────────────────────────────────────────────────────────
# cosmetic_rag_chat 의 settings.yaml 이 우선 사용. 아래는 env override.
# 비워두면 settings.yaml default 사용 — 보통 그대로 두면 됨.
# LLM_MODEL=gpt-3.5-turbo
# LLM_API_BASE=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_API_BASE=https://api.openai.com/v1
# GRAPHRAG_CONFIG=./src/rag_chatbot/cosmetic_rag_chat/indexing/settings.yaml
# METHOD=local
# COMMUNITY_LEVEL=2
# RESPONSE_TYPE="Multiple Paragraphs"
# TOKEN_LIMIT=4096
