# 변수 prefix 규칙: 모듈명_변수명 (LLM_, EMBED_, GRAPHRAG_, CRAWLER_, ...)
# `.env` 와 동기화 필수.
#
# 빠른 시작: 아래 default 값은 Ollama 로컬 변형 기준 (비용 0).
# OpenAI 변형 사용 시 OpenAI 섹션 주석 해제 + Ollama 섹션 주석 처리.

# === LLM (Ollama 로컬, 기본) ===
LLM_PROVIDER=ollama
LLM_MODEL=gemma2
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=dummy
LLM_SERVICE_TYPE=openai_chat

# === Embeddings (Ollama 로컬, 기본) ===
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_API_BASE=http://localhost:11434
EMBED_API_KEY=dummy
EMBED_SERVICE_TYPE=openai_embedding

# === OpenAI 변형 (사용 시 위 Ollama 섹션 주석 + 아래 주석 해제) ===
# LLM_MODEL=gpt-3.5-turbo
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# EMBED_MODEL=text-embedding-3-small
# EMBED_API_BASE=https://api.openai.com/v1
# EMBED_API_KEY=sk-...

# === GraphRAG ===
# GRAPHRAG_API_KEY: Ollama 만 사용 시 'dummy' OK. OpenAI 사용 시 sk-...
GRAPHRAG_API_KEY=dummy
# GRAPHRAG_CONFIG: 비워두면 챗봇 모듈의 indexing/settings.yaml 자동 사용
# GRAPHRAG_CONFIG=./src/rag_chatbot/cosmetic_rag_chat/indexing/settings.yaml

# === 무료 LLM provider (Groq + Gemini fallback) ===
# src/util/llm_provider.py 가 사용. 챗봇 query / RAG 평가 (judge LLM) 에 사용.
# 둘 다 무료 한도 안에서 충분 — 한쪽이 rate-limit 걸려도 다른 쪽 폴백.
#
# LLM_PROVIDER: auto (Groq → Gemini 폴백, 권장) / groq / gemini
LLM_PROVIDER=auto
# Groq: https://console.groq.com 에서 무료 가입 후 발급. ~1k RPM 무료.
GROQ_API_KEY=
# Gemini: https://aistudio.google.com 에서 무료 발급. ~15 RPM, 1.5M TPM/일.
GEMINI_API_KEY=
# 모델명 (옵션, 기본값 그대로 권장)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-flash-lite-latest

# === API server (옵션, 미사용 시 무시) ===
API_URL=http://localhost:8012
API_PORT=8012

# === Crawler (Amazon review crawler — 챗봇 실행만 할 거면 무시) ===
CRAWLER_ID=your-id
CRAWLER_PW=your-password
CRAWLER_DB_HOST=localhost
CRAWLER_DB_PORT=3306
CRAWLER_DB_NAME=your_database
CRAWLER_DB_USER=your_db_user
CRAWLER_DB_PASSWORD=your_db_password
# Optional: read-only replica DB
CRAWLER_DB_REPLICA_URL=

# === Slack notifications (옵션, 크롤러 알림용) ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# === TikTok crawler (옵션, 크롤러 실행 시만) ===
TIKTOK_EMAIL=your-tiktok-email@example.com
TIKTOK_PASSWORD=your-tiktok-password
