# Convention: every variable starts with a module prefix
# (LLM_, EMBED_, GRAPHRAG_, API_, CRAWLER_).
# Keep this file in sync with .env. New variables must follow the prefix rule.

# === LLM ===
LLM_PROVIDER=openai
LLM_MODEL='mistral-large:123b-instruct-2407-q4_0'
LLM_API_KEY=your-llm-api-key
LLM_SERVICE_TYPE=openai_chat

# === Embeddings ===
EMBED_PROVIDER=openai
EMBED_API_BASE=http://localhost:11434
EMBED_MODEL='snowflake-arctic-embed:335m'
EMBED_API_KEY=your-embed-api-key
EMBED_SERVICE_TYPE=openai_embedding

# === GraphRAG ===
GRAPHRAG_API_KEY=your-graphrag-api-key
GRAPHRAG_LLM_API_KEY=your-graphrag-llm-api-key
GRAPHRAG_CONFIG=/absolute/path/to/settings.yaml
GRAPHRAG_ROOT_DIR=/absolute/path/to/graphrag/root
GRAPHRAG_INPUT_DIR=${GRAPHRAG_ROOT_DIR}/output/${timestamp}/artifacts

# === API server ===
API_URL=http://localhost:8012
API_PORT=8012

# === Crawler (Amazon review crawler) ===
CRAWLER_ID=your-id
CRAWLER_PW=your-password
CRAWLER_DB_HOST=localhost
CRAWLER_DB_PORT=3306
CRAWLER_DB_NAME=your_database
CRAWLER_DB_USER=your_db_user
CRAWLER_DB_PASSWORD=your_db_password
# Optional: read-only replica DB. 다른 머신에 replica MySQL이 떠있을 때만 채우면
# 자동으로 read 트래픽을 replica로 라우팅. 비워두면 master만 사용.
CRAWLER_DB_REPLICA_URL=

# === Slack notifications ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
